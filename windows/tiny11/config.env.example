# Copy this file to a private location such as:
#   ~/.config/windows-tiny11-kvm/config.env
# Never add credentials or installation media to the repository.

WINDOWS_TINY11_RUNTIME_ROOT=/path/to/VirtualMachines/Windows-Tiny11
WINDOWS_TINY11_RAM_GIB=8
WINDOWS_TINY11_VCPUS=4
WINDOWS_TINY11_DISK_SIZE=128G
WINDOWS_TINY11_VNC_DISPLAY=43
WINDOWS_TINY11_NOVNC_PORT=6143
WINDOWS_TINY11_RDP_PORT=3399
WINDOWS_TINY11_SSH_PORT=2290
